{
  "name": "comparisons",
  "description": "Comparison, boolean, arithmetic, and conditional operators (E1 subset, E20).",
  "category": "comparison",
  "cases": [
    { "id": "cmp-eq-true", "description": "eq returns true for equal numbers",
      "expr": { "kind": "op", "op": "eq", "args": [ { "kind": "literal", "value": 1 }, { "kind": "literal", "value": 1 } ] },
      "scope": { "values": {}, "meta": {}, "data": {}, "services": {}, "permissions": {} },
      "expect": { "kind": "value", "value": true } },
    { "id": "cmp-eq-false", "description": "eq returns false for unequal",
      "expr": { "kind": "op", "op": "eq", "args": [ { "kind": "literal", "value": 1 }, { "kind": "literal", "value": 2 } ] },
      "scope": { "values": {}, "meta": {}, "data": {}, "services": {}, "permissions": {} },
      "expect": { "kind": "value", "value": false } },
    { "id": "cmp-ne-true", "description": "ne returns true for unequal",
      "expr": { "kind": "op", "op": "ne", "args": [ { "kind": "literal", "value": "a" }, { "kind": "literal", "value": "b" } ] },
      "scope": { "values": {}, "meta": {}, "data": {}, "services": {}, "permissions": {} },
      "expect": { "kind": "value", "value": true } },
    { "id": "cmp-gt", "description": "gt 5 > 3",
      "expr": { "kind": "op", "op": "gt", "args": [ { "kind": "literal", "value": 5 }, { "kind": "literal", "value": 3 } ] },
      "scope": { "values": {}, "meta": {}, "data": {}, "services": {}, "permissions": {} },
      "expect": { "kind": "value", "value": true } },
    { "id": "cmp-lte-equal", "description": "lte equal is true",
      "expr": { "kind": "op", "op": "lte", "args": [ { "kind": "literal", "value": 3 }, { "kind": "literal", "value": 3 } ] },
      "scope": { "values": {}, "meta": {}, "data": {}, "services": {}, "permissions": {} },
      "expect": { "kind": "value", "value": true } },
    { "id": "bool-and", "description": "and true&&false",
      "expr": { "kind": "op", "op": "and", "args": [ { "kind": "literal", "value": true }, { "kind": "literal", "value": false } ] },
      "scope": { "values": {}, "meta": {}, "data": {}, "services": {}, "permissions": {} },
      "expect": { "kind": "value", "value": false } },
    { "id": "bool-or", "description": "or true||false",
      "expr": { "kind": "op", "op": "or", "args": [ { "kind": "literal", "value": true }, { "kind": "literal", "value": false } ] },
      "scope": { "values": {}, "meta": {}, "data": {}, "services": {}, "permissions": {} },
      "expect": { "kind": "value", "value": true } },
    { "id": "bool-not", "description": "not false",
      "expr": { "kind": "op", "op": "not", "args": [ { "kind": "literal", "value": false } ] },
      "scope": { "values": {}, "meta": {}, "data": {}, "services": {}, "permissions": {} },
      "expect": { "kind": "value", "value": true } },
    { "id": "arith-add", "description": "add 2+3=5",
      "expr": { "kind": "op", "op": "add", "args": [ { "kind": "literal", "value": 2 }, { "kind": "literal", "value": 3 } ] },
      "scope": { "values": {}, "meta": {}, "data": {}, "services": {}, "permissions": {} },
      "expect": { "kind": "value", "value": 5 } },
    { "id": "arith-mul", "description": "mul 4*3=12",
      "expr": { "kind": "op", "op": "mul", "args": [ { "kind": "literal", "value": 4 }, { "kind": "literal", "value": 3 } ] },
      "scope": { "values": {}, "meta": {}, "data": {}, "services": {}, "permissions": {} },
      "expect": { "kind": "value", "value": 12 } },
    { "id": "arith-div", "description": "div 10/4=2.5",
      "expr": { "kind": "op", "op": "div", "args": [ { "kind": "literal", "value": 10 }, { "kind": "literal", "value": 4 } ] },
      "scope": { "values": {}, "meta": {}, "data": {}, "services": {}, "permissions": {} },
      "expect": { "kind": "value", "value": 2.5 } },
    { "id": "if-then-branch", "description": "if true then 1 else 2",
      "expr": { "kind": "if", "test": { "kind": "literal", "value": true }, "then": { "kind": "literal", "value": 1 }, "else": { "kind": "literal", "value": 2 } },
      "scope": { "values": {}, "meta": {}, "data": {}, "services": {}, "permissions": {} },
      "expect": { "kind": "value", "value": 1 } },
    { "id": "if-non-boolean-test-strict", "description": "E20: if test must be boolean (strict)",
      "expr": { "kind": "if", "test": { "kind": "literal", "value": 1 }, "then": { "kind": "literal", "value": "a" }, "else": { "kind": "literal", "value": "b" } },
      "scope": { "values": {}, "meta": {}, "data": {}, "services": {}, "permissions": {} },
      "expect": { "kind": "error", "code": "EXPR_OP_TYPE", "pathPattern": "if\\.test" } },
    { "id": "and-non-boolean", "description": "E2 strict: and operand must be boolean",
      "expr": { "kind": "op", "op": "and", "args": [ { "kind": "literal", "value": 1 }, { "kind": "literal", "value": true } ] },
      "scope": { "values": {}, "meta": {}, "data": {}, "services": {}, "permissions": {} },
      "expect": { "kind": "error", "code": "EXPR_OP_TYPE" } }
  ]
}
